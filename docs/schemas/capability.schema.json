{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jbgh/capability.schema.json",
  "title": "JBGH Capability Schema",
  "$comment": "Document ID: JBGH-SCH-003 | Status: DRAFT | Depends On: JBGH-003,JBGH-MC-001 | Requirement IDs: REQ-TECH-002,REQ-TECH-004",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilityId", "name", "phase", "inputs", "outputs"],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "enum": [
        "validateWorld",
        "discoverPacks",
        "resolveManifest",
        "resolveDependencies",
        "generateWorldPackLinks",
        "validatePackStack",
        "deployWorld"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["validate", "resolve", "deploy"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "error"] }
        },
        "additionalProperties": false
      }
    }
  }
}
